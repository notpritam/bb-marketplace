{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "notpritam",
  "displayName": "notpritam's BB Extensions",
  "description": "Personal BB plugins by notpritam. Add this marketplace and install the ones you want.",
  "plugins": [
    {
      "id": "guided-review",
      "displayName": "Guided Review",
      "description": "Review GitHub PRs in chapters, inspect diffs, ask an assistant, and keep private notes. Optional Needs You alerts when the guide is ready, plus updates while idle.",
      "icon": {
        "url": "./icons/guided-review.svg"
      },
      "tags": [
        "review",
        "github",
        "pull-request",
        "workflow"
      ],
      "author": {
        "name": "Pritam Sharma",
        "github": "notpritam",
        "url": "https://notpritam.in/plugins/guided-review"
      },
      "source": {
        "git": {
          "url": "https://github.com/notpritam/bb-plugin-guided-review.git",
          "range": "^0.2.1"
        }
      }
    },
    {
      "id": "inbox",
      "displayName": "Needs You",
      "description": "Questions, failed runs, finished threads, and extension activity in one inbox. Dismissible popups, optional guided Telegram setup, notification settings, and explicit updates.",
      "icon": {
        "url": "./icons/inbox.svg"
      },
      "tags": [
        "notifications",
        "inbox",
        "threads",
        "telegram",
        "workflow"
      ],
      "author": {
        "name": "Pritam Sharma",
        "github": "notpritam",
        "url": "https://notpritam.in/plugins/needs-you"
      },
      "source": {
        "git": {
          "url": "https://github.com/notpritam/bb-plugin-inbox.git",
          "range": "^0.2.0"
        }
      }
    },
    {
      "id": "glass",
      "displayName": "Transparency",
      "description": "Translucent BB surfaces with six animated backdrops, custom GLSL shaders, wallpaper, and adjustable frost. Preview your look and tune colors, surfaces, and motion.",
      "icon": {
        "url": "./icons/glass.svg"
      },
      "tags": [
        "theme",
        "appearance",
        "glass",
        "shaders",
        "wallpaper"
      ],
      "author": {
        "name": "Pritam Sharma",
        "github": "notpritam",
        "url": "https://notpritam.in/plugins/transparency"
      },
      "source": {
        "git": {
          "url": "https://github.com/notpritam/bb-plugin-glass.git",
          "range": "^0.2.0"
        }
      }
    },
    {
      "id": "local-voice",
      "displayName": "Local Voice",
      "description": "Local dictation for bb: Qwen3-ASR + Gemma 4 on your own machine (any language in, clean English out), a mic on every text field, usage insights, a voice profile and a public leaderboard. Needs llama.cpp + ~5 GB of models (host/setup.sh).",
      "icon": {
        "url": "./icons/local-voice.svg"
      },
      "tags": [
        "voice",
        "dictation",
        "speech-to-text",
        "local-ai",
        "leaderboard"
      ],
      "author": {
        "name": "Pritam Sharma",
        "github": "notpritam",
        "url": "https://voice.notpritam.in"
      },
      "source": {
        "git": {
          "url": "https://github.com/notpritam/bb-plugin-local-voice.git",
          "range": "^1.1.0"
        }
      }
    }
  ]
}
