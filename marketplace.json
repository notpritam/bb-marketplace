{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "notpritam",
  "displayName": "notpritam's BB Extensions",
  "description": "Personal BB plugins by notpritam. Add this marketplace and install the ones you want.",
  "plugins": [
    {
      "id": "guided-review",
      "displayName": "Guided Review",
      "description": "Review GitHub PRs in chapters, inspect diffs, ask a review assistant, and keep private notes. Team setup, revision-checked submissions, and optional updates while idle.",
      "icon": {
        "url": "./icons/guided-review.svg"
      },
      "tags": [
        "review",
        "github",
        "pull-request",
        "workflow"
      ],
      "author": {
        "name": "Pritam Sharma",
        "github": "notpritam",
        "url": "https://notpritam.in/plugins/guided-review"
      },
      "source": {
        "git": {
          "url": "https://github.com/notpritam/bb-plugin-guided-review.git",
          "range": "^0.2.0"
        }
      }
    },
    {
      "id": "inbox",
      "displayName": "Needs You",
      "description": "Questions, failed runs, and finished threads in one calm inbox. One dismissible popup per thread, with optional Telegram notifications. Public beta with guided Telegram setup, notification settings, and update controls.",
      "icon": {
        "url": "./icons/inbox.svg"
      },
      "tags": [
        "notifications",
        "inbox",
        "threads",
        "telegram",
        "workflow"
      ],
      "author": {
        "name": "Pritam Sharma",
        "github": "notpritam",
        "url": "https://notpritam.in/plugins/needs-you"
      },
      "source": {
        "git": {
          "url": "https://github.com/notpritam/bb-plugin-inbox.git",
          "range": "^0.2.0-beta.1"
        }
      }
    },
    {
      "id": "glass",
      "displayName": "Transparency",
      "description": "Translucent BB surfaces with ambient backdrops, custom wallpaper, and adjustable frost. Clear setup, automatic saving, and reduced-motion support.",
      "icon": {
        "url": "./icons/glass.svg"
      },
      "tags": [
        "theme",
        "appearance",
        "glass",
        "ui"
      ],
      "author": {
        "name": "notpritam",
        "github": "notpritam"
      },
      "source": {
        "git": {
          "url": "https://github.com/notpritam/bb-plugin-glass.git",
          "range": "^0.1.0"
        }
      }
    }
  ]
}
